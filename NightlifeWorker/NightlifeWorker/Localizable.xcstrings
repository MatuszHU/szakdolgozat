            "value" : "%@ h"
          }
        }
      }
    },
    "A helyszín tervrajza szintenként, a munkaterületeddel és azzal, hogy a kollégák melyik zónában jelentkeztek be utoljára." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The floor plan of the venue, floor by floor, with your work area and the zone where each colleague last checked in."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A helyszín tervrajza szintenként, a munkaterületeddel és azzal, hogy a kollégák melyik zónában jelentkeztek be utoljára."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A planta do local, piso a piso, com a tua área de trabalho e a zona onde cada colega fez o último check-in."
          }
        }
      }
    },
    "A helyszín tervrajzát az adminisztrátor készíti el." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The administrator draws the floor plan of the venue."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A helyszín tervrajzát az adminisztrátor készíti el."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O administrador desenha a planta do local."
          }
        }
      }
    },
    "A kép közepéből egy legfeljebb 512 × 512 pixeles négyzet készül." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A square of at most 512 × 512 pixels is cut from the middle of the photo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kép közepéből egy legfeljebb 512 × 512 pixeles négyzet készül."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É recortado do centro da fotografia um quadrado de, no máximo, 512 × 512 píxeis."
          }
        }
      }
    },
    "A készletlistát az adminisztrátor állítja össze." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The administrator sets up the stock list."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A készletlistát az adminisztrátor állítja össze."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O administrador define a lista de stock."
          }
        }
      }
    },
    "A kódolvasó nem érhető el" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The code reader is not available"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kódolvasó nem érhető el"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O leitor de códigos não está disponível"
          }
        }
      }
    },
    "A ledolgozott óráid az aktuális és az előző elszámolási időszakban, valamint a korábbi feladataid." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your hours worked in the current and the previous pay period, and your past tasks."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ledolgozott óráid az aktuális és az előző elszámolási időszakban, valamint a korábbi feladataid."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tuas horas trabalhadas no período de pagamento atual e no anterior, e as tuas tarefas anteriores."
          }
        }
      }
    },
    "A műszakjaidat az adminisztrátor osztja be." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your shifts are assigned by the administrator."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A műszakjaidat az adminisztrátor osztja be."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os teus turnos são atribuídos pelo administrador."
          }
        }
      }
    },
    "A profilkép, a nyelv, az útmutató, a névjegy és a kijelentkezés egy helyen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile picture, language, guide, about and signing out in one place."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A profilkép, a nyelv, az útmutató, a névjegy és a kijelentkezés egy helyen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografia de perfil, idioma, guia, informações e terminar sessão num só lugar."
          }
        }
      }
    },
    "A rendszer nyelve" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System language"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rendszer nyelve"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idioma do sistema"
          }
        }
      }
    },
    "A saját műszakjaid időponttal, szinttel, zónával és a neked kiosztott feladatokkal. A folyamatban lévő műszak külön látszik, a korábbiak a lista alján." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your own shifts with time, floor, zone and the tasks given to you. The shift in progress is shown separately, past ones at the bottom of the list."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A saját műszakjaid időponttal, szinttel, zónával és a neked kiosztott feladatokkal. A folyamatban lévő műszak külön látszik, a korábbiak a lista alján."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os teus turnos com hora, piso, zona e as tarefas que te foram atribuídas. O turno em curso aparece à parte e os anteriores no fim da lista."
          }
        }
      }
    },
