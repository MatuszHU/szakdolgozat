    "Az elbírált készletkérések, a neked szóló pánikjelzések és az új beosztások egy listában. Koppintásra olvasottá válnak." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decided supply requests, panic alerts sent to you and new shifts in one list. Tap one to mark it as read."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az elbírált készletkérések, a neked szóló pánikjelzések és az új beosztások egy listában. Koppintásra olvasottá válnak."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedidos de stock decididos, alertas de pânico enviados para ti e novos turnos numa só lista. Toca numa notificação para a marcar como lida."
          }
        }
      }
    },
