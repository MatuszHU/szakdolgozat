    "Biztosan kijelentkezel?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you really want to sign out?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan kijelentkezel?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du dich wirklich abmelden?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tens a certeza de que queres terminar sessão?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naozaj sa chceš odhlásiť?"
          }
        },
        "ro": {
