{
  "sourceLanguage": "en",
  "strings": {
    "%@ tickets are sold out": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tickets are sold out"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ jegyek elfogytak"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Tickets sind ausverkauft"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os bilhetes %@ estão esgotados"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vstupenky %@ sú vypredané"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Biletele %@ s-au epuizat"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulaznice %@ su rasprodane"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Квитки %@ розпродано"
          }
        }
      }
    },
