    "A bejáratnál mutasd fel a jegyed QR-kódját. Minden jegy egyszer használható fel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the QR code of your ticket at the entrance. Each ticket can be used once."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejáratnál mutasd fel a jegyed QR-kódját. Minden jegy egyszer használható fel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige am Eingang den QR-Code deines Tickets. Jedes Ticket gilt nur einmal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o código QR do bilhete à entrada. Cada bilhete só pode ser usado uma vez."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri vchode ukáž QR kód vstupenky. Každú vstupenku možno použiť iba raz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La intrare arată codul QR al biletului. Fiecare bilet poate fi folosit o singură dată."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ulazu pokaži QR kôd ulaznice. Svaka se ulaznica može iskoristiti samo jednom."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На вході покажіть QR-код квитка. Кожен квиток можна використати лише раз."
          }
        }
      }
    },
    "A helyszín tervrajza hamarosan itt lesz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The floor plan of the venue will be here soon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyszín tervrajza hamarosan itt lesz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Lageplan des Veranstaltungsorts ist bald hier."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A planta do local estará aqui em breve."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plán podniku tu bude čoskoro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planul locației va fi aici în curând."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlocrt prostora uskoro će biti ovdje."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "План закладу незабаром з’явиться тут."
          }
        }
      }
    },
    "A jegyeid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tickets"
          }
        },
        "hu": {
          "stringUnit": {
