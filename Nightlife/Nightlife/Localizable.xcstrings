    "Válassz eseményt és jegytípust, add meg a darabszámot, majd fizess. A jegyeid a Jegyeim között jelennek meg.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an event and a ticket type, set the quantity and pay. Your tickets appear under My tickets."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz eseményt és jegytípust, add meg a darabszámot, majd fizess. A jegyeid a Jegyeim között jelennek meg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Veranstaltung und eine Ticketart, gib die Anzahl an und bezahle. Deine Tickets findest du unter Meine Tickets."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um evento e um tipo de bilhete, indica a quantidade e paga. Os bilhetes aparecem em Os meus bilhetes."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber podujatie a typ vstupenky, zadaj počet a zaplať. Vstupenky nájdeš v časti Moje vstupenky."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege un eveniment și un tip de bilet, stabilește cantitatea și plătește. Biletele apar la Biletele mele."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi događaj i vrstu ulaznice, unesi količinu i plati. Ulaznice se pojavljuju pod Moje ulaznice."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть подію й тип квитка, вкажіть кількість і оплатіть. Квитки з’являться в розділі «Мої квитки»."
          }
        }
      }
    },
    "Válts a szintek között, és megtalálod a bárt, a mosdókat, a színpadot és a kijáratokat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between the floors to find the bar, the toilets, the stage and the exits."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válts a szintek között, és megtalálod a bárt, a mosdókat, a színpadot és a kijáratokat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle zwischen den Etagen, um Bar, Toiletten, Bühne und Ausgänge zu finden."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda de piso para encontrares o bar, as casas de banho, o palco e as saídas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepínaj medzi poschodiami a nájdeš bar, toalety, pódium aj východy."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comută între etaje ca să găsești barul, toaletele, scena și ieșirile."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijenjaj katove i pronaći ćeš bar, toalete, pozornicu i izlaze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемикайте поверхи, щоб знайти бар, туалети, сцену та виходи."
          }
        }
      }
    },
    "You are already registered for this raffle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are already registered for this raffle"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erre a nyereményjátékra már jelentkeztél"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nimmst an diesem Gewinnspiel bereits teil"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já estás inscrito neste sorteio"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Do tejto súťaže si už prihlásený"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Te-ai înscris deja la această tombolă"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Već ste prijavljeni za ovu nagradnu igru"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви вже зареєстровані в цьому розіграші"
          }
        }
      }
    },
    "You are registered. Good luck!": {
