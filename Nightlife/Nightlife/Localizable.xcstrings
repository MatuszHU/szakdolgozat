    "Itt vásárolhatsz jegyet, megtalálod a helyszín térképét és jelentkezhetsz a nyereményjátékokra.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buy tickets, find the map of the venue and join the raffles here."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt vásárolhatsz jegyet, megtalálod a helyszín térképét és jelentkezhetsz a nyereményjátékokra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier kaufst du Tickets, findest den Lageplan und nimmst an Gewinnspielen teil."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui compras bilhetes, encontras a planta do local e participas nos sorteios."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu si kúpiš vstupenky, nájdeš mapu podniku a prihlásiš sa do súťaží."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aici cumperi bilete, găsești harta locației și te înscrii la tombole."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje kupuješ ulaznice, nalaziš kartu prostora i prijavljuješ se za nagradne igre."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут можна купити квитки, знайти мапу закладу й узяти участь у розіграшах."
          }
        }
      }
    },
