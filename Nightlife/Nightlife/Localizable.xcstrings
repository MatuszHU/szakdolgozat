          }
        }
      }
    },
    "A térkép még nem elérhető": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The map is not available yet"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A térkép még nem elérhető"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Karte ist noch nicht verfügbar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O mapa ainda não está disponível"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapa zatiaľ nie je dostupná"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Harta nu este încă disponibilă"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta još nije dostupna"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мапа ще недоступна"
          }
        }
      }
    },
    "Amint új esemény kerül meghirdetésre, itt vásárolhatsz rá jegyet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As soon as a new event is announced, you can buy tickets for it here."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amint új esemény kerül meghirdetésre, itt vásárolhatsz rá jegyet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald eine neue Veranstaltung angekündigt wird, kannst du hier Tickets kaufen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim que for anunciado um novo evento, podes comprar bilhetes aqui."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hneď ako bude ohlásené nové podujatie, môžeš si tu kúpiť vstupenky."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Imediat ce este anunțat un eveniment nou, poți cumpăra bilete aici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čim se objavi novi događaj, ovdje možeš kupiti ulaznice."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щойно оголосять нову подію, тут можна буде купити квитки."
          }
        }
      }
    },
    "Az esemény végéig egyszer jelentkezhetsz egy nyereményjátékra. Sok szerencsét!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can register once for a raffle until the event ends. Good luck!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az esemény végéig egyszer jelentkezhetsz egy nyereményjátékra. Sok szerencsét!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zum Ende der Veranstaltung kannst du einmal an einem Gewinnspiel teilnehmen. Viel Glück!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes inscrever-te uma vez num sorteio até ao fim do evento. Boa sorte!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Do konca podujatia sa môžeš do súťaže prihlásiť raz. Veľa šťastia!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Te poți înscrie o singură dată la o tombolă până la sfârșitul evenimentului. Mult noroc!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Do kraja događaja za nagradnu igru možeš se prijaviti jednom. Sretno!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До завершення події можна один раз зареєструватися в розіграші. Успіху!"
          }
        }
      }
    },
