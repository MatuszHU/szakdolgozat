            "value": "A jegyeid"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tickets"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus bilhetes"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje vstupenky"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Biletele tale"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje ulaznice"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші квитки"
          }
        }
      }
    },
    "A kép közepéből egy legfeljebb 512 × 512 pixeles négyzet készül.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A square of at most 512 × 512 pixels is cut from the middle of the photo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kép közepéből egy legfeljebb 512 × 512 pixeles négyzet készül."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus der Mitte des Fotos wird ein Quadrat von höchstens 512 × 512 Pixeln ausgeschnitten."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É recortado do centro da fotografia um quadrado de, no máximo, 512 × 512 píxeis."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo stredu fotky sa vyreže štvorec s veľkosťou najviac 512 × 512 pixelov."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Din mijlocul fotografiei se decupează un pătrat de cel mult 512 × 512 pixeli."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Iz sredine fotografije izrezuje se kvadrat od najviše 512 × 512 piksela."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З центру фото вирізається квадрат розміром до 512 × 512 пікселів."
          }
        }
      }
    },
    "A nyereményjátékokat a szervezők hirdetik meg.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The organisers announce the raffles."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyereményjátékokat a szervezők hirdetik meg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Veranstalter kündigen die Gewinnspiele an."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os organizadores anunciam os sorteios."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súťaže vyhlasujú organizátori."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizatorii anunță tombolele."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagradne igre objavljuju organizatori."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розіграші оголошують організатори."
          }
        }
      }
    },
    "A rendszer nyelve": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System language"
          }
        },
